# Optional API endpoint overrides (same-origin defaults are recommended)
VITE_CHAT_API_URL=/api/chat
VITE_LOGIN_API_URL=/api/login

# OpenRouter keys used by the Vercel API route
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Redirect URL after successful login
VITE_AUTH_REDIRECT_URL=/

# Login credentials (set these in Vercel; do not use VITE_ so they stay server-only)
